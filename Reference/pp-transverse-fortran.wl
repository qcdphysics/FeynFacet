(* The code's pieces of class J0 in the basis of this package (see the header). *)
PPTransverseFortranCoefficients[J0_Integer] := Module[{p = PPTransverseFortran["Classes"][J0]},
  <|"Class" -> J0, "Name" -> p["Name"],
    "Born" -> alphaS^2 2 (1 - v) p["F0"]/Pi,
    "Regular" -> 2 v w (p["STRUV"] + (p["AVWPL"] - (p["AVWPL"] /. w -> 1))/(1 - w) + (p["AVLO"] - (p["AVLO"] /. w -> 1)) Log[1 - w]/(1 - w))/p["CC"],
    "D0" -> 2 v (p["AVWPL"] /. w -> 1)/p["CC"],
    "D1" -> 2 v (p["AVLO"] /. w -> 1)/p["CC"],
    "Delta" -> 2 v p["AVDEL"]/p["CC"],
    "Prefactor" -> alphaS^3/(Pi s v w), "Basis" -> {"regular", "D0", "D1", "delta"},
    "Scales" -> {Log[muR^2/s], Log[muF^2/s], Log[muFF^2/s]}, "Pieces" -> p|>];

