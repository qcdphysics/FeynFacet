Notebook[
 {
  Cell[
   "TMD beam and soft functions, step 2 (FORM route): squared matrix \
elements", "Title"], Cell["Same task and same output format as the FeynCalc \
route (read its introduction for the definitions), now with FORM.  Input: the \
amplitude records of step 1.  Output: Results/FORM/Algebra.wl.  The \
amplitudes are written to a FORM include file; the program form/Square.frm \
squares the amplitudes of one channel with the normalization given on its \
command line, and its header form/common.h contains the conjugation, the \
closing of the operator index, the polarization and colour sums.  The \
notebook only collects the results and performs the same checks as the \
FeynCalc route.", "Text"], Cell["Load and export the amplitudes", "Section"], 
  Cell["Get[FileNameJoin[{NotebookDirectory[], \"..\", \"..\", \"FeynFacet\", \
\"FeynFacet.wl\"}]]", "Input"], Cell["records = \
LoadAmplitudes[][\"Records\"];\nworkDir = \
FileNameJoin[{ResultsDirectory[\"FORM\"], \"form\"}];\n(* one FORM expression \
per diagram: BeamQQ1, BeamQQ2, ... *)\nlabelled = Association @ \
Flatten[KeyValueMap[Function[{name, list}, Table[name <> ToString[i] -> \
list[[i]], {i, Length[list]}]], records]];\nWriteFORMAmplitudes[labelled, \
workDir];\nKeys[labelled]", "Input"], 
  Cell["Import[FileNameJoin[{workDir, \"amplitudes.inc\"}], \"Text\"]", 
   "Input"], Cell["Square every channel", "Section"], 
  Cell["The normalizations are those of the FeynCalc route: quark operator \
1/(2 n.p) with the averages 1/2 and 1/Nc (incoming quark) or 1/(D-2) and \
1/(Nc^2-1) (incoming gluon); gluon operator 1/(x (n.p)^2) with the same \
averages; soft function 1/Nc or 1/(Nc^2-1) for the colour trace.  The \
operator markers gOp, gSoft are divided out.", "Text"], 
  Cell["program = FileNameJoin[{NotebookDirectory[], \"form\", \
\"Square.frm\"}];\nchannels = <|\n  \"BornQ\"  -> {\"BornQ1\", \
\"1/(2*2*Nc*pn*gOp^2)\", \"beam\"},\n  \"BornG\"  -> {\"BornG1\", \
\"1/((D-2)*(Nc^2-1)*pn^2*gOp^2)\", \"beam\"},\n  \"BeamQQ\" -> \
{\"BeamQQ1+BeamQQ2\", \"1/(2*2*Nc*pn*gOp^2)\", \"beam\"},\n  \"BeamQG\" -> \
{\"BeamQG1+BeamQG2\", \"1/((D-2)*(Nc^2-1)*2*pn*gOp^2)\", \"beam\"},\n  \
\"BeamGQ\" -> {\"BeamGQ1\", \"1/(2*Nc*x*pn^2*gOp^2)\", \"beam\"},\n  \
\"BeamGG\" -> {\"BeamGG1+BeamGG2+BeamGG3+BeamGG4\", \
\"1/((D-2)*(Nc^2-1)*x*pn^2*gOp^2)\", \"beam\"},\n  \"SoftQ\"  -> \
{\"SoftQ1+SoftQ2\", \"1/(Nc*gSoft^2)\", \"soft\"},\n  \"SoftG\"  -> \
{\"SoftG1+SoftG2\", \"1/((Nc^2-1)*gSoft^2)\", \
\"soft\"}|>;\nDo[RunFORM[program, workDir, \"Define\" -> {\"AMP=\" <> \
channels[name][[1]], \"NORM=\" <> channels[name][[2]], \"KIN=\" <> \
channels[name][[3]], \"OUT=\" <> name <> \".m\"}], {name, \
Keys[channels]}];\nsquares = AssociationMap[Factor[ReadFORM[workDir, # <> \
\".m\"]] &, Keys[channels]]", "Input"], Cell["FORM leaves the invariants as \
symbols: pn = n.p, kn = n.k, pk = p.k, kb = nb.k.  For the beam channels n.k \
= (1-x) n.p, p.k = kT2/(2(1-x)) and nb.k = kT2/((1-x) n.p); the soft matrix \
element keeps kn and kb.", "Text"], Cell["beamKinematics = {kn -> (1 - x) pn, \
pk -> kT2/(2 (1 - x)), kb -> kT2/((1 - x) pn)};\nsquares = Association @ \
KeyValueMap[#1 -> If[channels[#1][[3]] === \"beam\", Factor[#2 /. \
beamKinematics], #2] &, squares]", "Input"], Cell["Checks and output", 
   "Section"], Cell["Colour factors through CF and CA (FORM's results contain \
Nc, CF and CA); then the same checks as in the FeynCalc route: Born = 1, the \
real-emission kernels are the D-dimensional splitting functions, the soft \
matrix element is 4 gs^2 C_i/((n.k)(nb.k)).", "Text"], 
  Cell["colourFactors[expr_] := Factor[expr /. CF -> (Nc^2 - 1)/(2 Nc) /. CA \
-> Nc] /. (-1 + Nc) (1 + Nc) -> 2 Nc CF /. Nc -> CA;\nborn = <|\"q\" -> \
colourFactors[squares[\"BornQ\"]], \"g\" -> \
colourFactors[squares[\"BornG\"]]|>;\nRequire[born === <|\"q\" -> 1, \"g\" -> \
1|>, \"The Born matrix elements are not normalized to 1\", born];\nreal = \
colourFactors /@ <|\"qq\" -> squares[\"BeamQQ\"], \"qg\" -> \
squares[\"BeamQG\"], \"gq\" -> squares[\"BeamGQ\"], \"gg\" -> \
squares[\"BeamGG\"]|>;\nsoft = colourFactors /@ <|\"q\" -> \
squares[\"SoftQ\"], \"g\" -> squares[\"SoftG\"]|>;\nRequire[FreeQ[real, pn], \
\"The real matrix elements depend on n.p\", real];\nkernels = Map[Factor[# \
kT2/gs^2] &, real];\nexpected = <|\"qq\" -> 2 CF ((1 + x^2)/(1 - x) - eps (1 \
- x)), \"qg\" -> 2 (1/2) (1 - 2 x (1 - x)/(1 - eps)),\n  \"gq\" -> 2 CF ((1 + \
(1 - x)^2)/x - eps x), \"gg\" -> 4 CA (x/(1 - x) + (1 - x)/x + x (1 - \
x))|>;\nRequire[And @@ Table[Simplify[kernels[c]/(1 - x) /. D -> 4 - 2 eps] \
=== Simplify[expected[c]], {c, Keys[kernels]}],\n  \"The real-emission \
kernels differ from the D-dimensional splitting functions\", \
kernels];\nRequire[Simplify[soft[\"q\"] - 4 gs^2 CF/(kn kb)] === 0 && \
Simplify[soft[\"g\"] - 4 gs^2 CA/(kn kb)] === 0, \"Soft matrix elements \
differ from 4 gs^2 C_i/((n.k)(nb.k))\", soft];\nTableForm[Normal[kernels], \
TableHeadings -> {None, {\"channel\", \"kT2 M2/gs^2\"}}]", "Input"], 
  Cell["algebra = <|\"Born\" -> born, \"Real\" -> real, \"Soft\" -> \
soft|>;\nSaveResult[\"Algebra\", algebra, \"FORM\"];\nKeys[algebra]", 
   "Input"]}, WindowSize -> {1000, 800}]
