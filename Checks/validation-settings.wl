(* FeynFacet: parameters of the sampled analytic comparisons.
   Load with Get["Checks/validation-settings.wl"] from the repository root. All paths refer to the public
   repository root, https://github.com/qcdphysics/FeynFacet.
   These are comparison settings, not a claim of identities at all kinematics.
   The parameters specify the mathematical comparison tests. Random algebra
   probes are regenerated by the indicated scripts; the fixed finite points
   below specify the coefficient comparisons. *)
<|
 "Repository" -> "https://github.com/qcdphysics/FeynFacet",
 "DistributionBasis" -> {"regular", "D0", "D1", "delta"},
 "ParameterNames" -> "Association keys such as v and muR are strings; all point values are exact. TMD.wl uses x for the matching argument xi of the manuscript; LQ is held fixed in the convolution.",

 "FiniteCrossRouteAndCanonicalization" -> <|
   "Script" -> "Checks/collect_coefficients.wls",
   "Routes" -> {"FeynCalc", "FORM", "Tracer"},
   "Seed" -> 20261011,
   "PointGenerationWolframVersion" -> 15,
   "Points" -> {<|"v" -> 1/2, "w" -> 13/100, "s" -> 14, "muR" -> 1/3, "muF" -> 7/4,
  "muFF" -> 1/5, "muI" -> 1/6, "muO" -> 4/7, "muL" -> 3, "Nf" -> 6,
  "CA" -> 3, "CF" -> 4/3, "Nc" -> 3, "TR" -> 1/2|>,
 <|"v" -> 1/5, "w" -> 12/25, "s" -> 5, "muR" -> 3, "muF" -> 1/4,
  "muFF" -> 8/5, "muI" -> 1/6, "muO" -> 4/7, "muL" -> 2, "Nf" -> 1,
  "CA" -> 3, "CF" -> 4/3, "Nc" -> 3, "TR" -> 1/2|>,
 <|"v" -> 1/20, "w" -> 16/25, "s" -> 30, "muR" -> 7/3, "muF" -> 2,
  "muFF" -> 2/5, "muI" -> 7/6, "muO" -> 3/7, "muL" -> 9/2, "Nf" -> 3,
  "CA" -> 3, "CF" -> 4/3, "Nc" -> 3, "TR" -> 1/2|>,
 <|"v" -> 39/100, "w" -> 27/100, "s" -> 5, "muR" -> 3, "muF" -> 5/4,
  "muFF" -> 4/5, "muI" -> 5/6, "muO" -> 2/7, "muL" -> 9/2, "Nf" -> 4,
  "CA" -> 5, "CF" -> 12/5, "Nc" -> 5, "TR" -> 1/2|>,
 <|"v" -> 47/50, "w" -> 79/100, "s" -> 16, "muR" -> 8/3, "muF" -> 5/4,
  "muFF" -> 1/5, "muI" -> 1/3, "muO" -> 5/7, "muL" -> 3/2, "Nf" -> 4,
  "CA" -> 5, "CF" -> 12/5, "Nc" -> 5, "TR" -> 1/2|>,
 <|"v" -> 21/50, "w" -> 2/5, "s" -> 33, "muR" -> 1/3, "muF" -> 7/4,
  "muFF" -> 1/5, "muI" -> 5/6, "muO" -> 5/7, "muL" -> 7/2, "Nf" -> 3,
  "CA" -> 5, "CF" -> 12/5, "Nc" -> 5, "TR" -> 1/2|>},
   "RequestedDigits" -> 40,
   "Enforced" -> <|
     "CrossRouteMaximumAbsoluteDifference" -> 10^-30,
     "CanonicalizationDifference" -> <|
       "Threshold" -> 10^-30,
       "Metric" -> "Abs[original-canonical]/Abs[original]; use Abs[canonical] when Abs[original]<10^-30"|>,
     "UnwantedConstantCoefficientAbsoluteDifference" -> 10^-30|>,
   "Scope" -> "Finite results are compared when available. For transverse classes with shared scalar stages, missing route-specific finite results are accepted only after exact sampled comparisons of the native algebra, as specified in the collection script."|>,

 "PPLiteratureUUAndLL" -> <|
   "Scripts" -> {"Processes/Hadronic/4-Unpolarized.wl",
     "Processes/Hadronic/5-Polarized.wl"},
   "ReferenceData" -> "Reference/pp-fortran-values.wl",
   "Classes" -> Range[16],
   "KinematicPoints" -> {{3/10, 1/5}, {3/10, 3/5}, {3/10, 9/10},
     {11/20, 1/5}, {11/20, 3/5}, {11/20, 9/10},
     {4/5, 1/5}, {4/5, 3/5}, {4/5, 9/10}},
   "KinematicPointOrder" -> {"v", "w"},
   "CommonParameters" -> <|"s" -> 1, "Nf" -> 4, "CA" -> 3,
     "CF" -> 4/3, "alphaS" -> 1, "muR" -> Sqrt[9/10],
     "muF" -> Sqrt[7/10], "muFF" -> Sqrt[13/10]|>,
   "CandidateRequestedDigits" -> 20,
   "ReferencePrecision" -> "Machine-precision reference samples; requesting 20 digits does not increase their accuracy.",
   "DifferenceMetric" -> "(ours_j-reference_j)/(Abs[reference_j]+Max[Abs[reference]]/100), for the four coefficients at one point",
   "BothZeroAbsoluteCutoff" -> 10^-10,
   "EnforcedBornMaximumAbsoluteDifference" -> 10^-8,
   "EnforcedMaximumScaledCoefficientDifference" -> 10^-6|>,

 "PPLiteratureIncomingTT" -> <|
   "Script" -> "Processes/HadronicTT/4-Transverse.wl",
   "ReferenceExpressions" -> "Reference/pp-transverse-fortran.wl",
   "Classes" -> {5, 6, 7, 11, 12},
   "KinematicPoints" -> {{3/10, 1/5}, {11/20, 3/5}, {4/5, 9/10},
     {1/2, 1/2}, {2/5, 7/10}, {19/20, 1/20}},
   "KinematicPointOrder" -> {"v", "w"},
   "FlavorCounts" -> {4, 5},
   "Colors" -> {<|"CA" -> 3, "CF" -> 4/3|>,
     <|"CA" -> 2, "CF" -> 3/4|>, <|"CA" -> 5, "CF" -> 12/5|>},
   "CommonParameters" -> <|"s" -> 7/5, "alphaS" -> 1,
     "muR" -> Sqrt[9/10], "muF" -> Sqrt[7/10], "muFF" -> Sqrt[13/10]|>,
   "RequestedDigits" -> 30,
   "DifferenceMetric" -> "(ours_j-reference_j)/(Abs[reference_j]+Max[Abs[reference]]/100), for the four coefficients at one point",
   "BothZeroAbsoluteCutoff" -> 10^-25,
   "EnforcedSU3BornMaximumAbsoluteDifference" -> 10^-20,
   "EnforcedSU3MaximumScaledCoefficientDifference" -> 10^-20,
   "OtherColors" -> "CA=2 and CA=5 comparisons are reported; the script imposes no acceptance threshold on them."|>,

 "FiniteTransverseCrossing" -> <|
   "Script" -> "Processes/HadronicTransfer/5-Crossing.wl",
   "PointDefinitions" -> "FeynFacet/Compare.wl",
   "TransferClasses" -> {1, 3, 6, 10, 11, 13, 17},
   "IncomingTTPartners" -> {5, 5, 11, 7, 11, 12, 6},
   "Method" -> "Compare direct and crossed Born and scalar integrands before integration; use common reduction, masters and assembly in the transfer physical region with transfer counterterms.",
   "SharedInputs" -> "Finite direct/crossed comparisons share canonical reduced-real integrals, Born terms and master values; virtual forms can differ. Algebra comparisons in step 5 supply the nontrivial crossing test.",
   "RealAlgebraProbes" -> <|"Count" -> 3, "Arithmetic" -> "Exact rational",
     "Generation" -> "Processes/HadronicTransfer/5-Crossing.wl, realPoints; fresh rational invariants with C=-(s+t+u)-A-B, D and CA sampled."|>,
   "Points" -> {
     <|"s" -> 17, "v" -> 2/5, "w" -> 3/7, "Nf" -> 4,
       "muR" -> Sqrt[29], "muF" -> Sqrt[19], "muFF" -> Sqrt[23]|>,
     <|"s" -> 31, "v" -> 5/11, "w" -> 4/9, "Nf" -> 5,
       "muR" -> Sqrt[43], "muF" -> Sqrt[37], "muFF" -> Sqrt[41]|>,
     <|"s" -> 7, "v" -> 3/4, "w" -> 2/3, "Nf" -> 3,
       "muR" -> Sqrt[13], "muF" -> Sqrt[5], "muFF" -> Sqrt[11]|>},
   "Enforced" -> <|
     "Born" -> "Exact zero difference, before sampling.",
     "FiniteRealVirtualCountertermsAndTotal" -> "Exact zero differences at the three (s,v,w,Nf) points, with the three scales and CA symbolic and CF=(CA^2-1)/(2 CA)."|>,
   "ReportedNumericComparison" -> <|"CA" -> 3, "RequestedDigits" -> 30,
     "AbsoluteChop" -> 10^-15,
     "AcceptanceCriterion" -> False,
     "Explanation" -> "Numeric residuals are evaluated after Chop; the exact sampled differences above provide the required equality tests."|>|>,

 "HadronicAlgebraComparisons" -> <|
   "Scripts" -> {"Processes/Hadronic/2-Algebra-FORM.wl", "Processes/Hadronic/2-Algebra-Tracer.wl"},
   "Arithmetic" -> "Exact rational; two freshly generated points per comparison.",
   "Generation" -> "The final comparison cell in each script defines its point generator, scalar-master probes, color relation and invariant constraint.",
   "Scope" -> "Sampled Born, real and virtual agreement; not a generic symbolic identity."|>,

 "TransferClass13Algebra" -> <|
   "Scripts" -> {"Checks/native/TransferRouteFORM.wls", "Checks/native/TransferRouteTracer.wls"},
   "Seeds" -> <|"FORM" -> 2026101701, "Tracer" -> 2026101702|>,
   "QuantitiesPerRoute" -> 20, "PointsPerRoute" -> 2,
   "Arithmetic" -> "Exact rational; scripts save exact-points.wl.",
   "VirtualComparison" -> "Both literal and angularly projected comparisons are reported. Angularly projected agreement is required; the literal NN integrands can differ.",
   "SourceGuard" -> "The guard covers the final comparison block. FORM's auxiliary hat-projection definitions are copied separately and are not covered."|>,

 "IndependentTransferAssembly" -> <|
   "Scripts" -> {"Checks/transfer/IndependentAssembly.wls", "Checks/transfer/CompareIndependentCrossing.wls"},
   "Derivation" -> "Checks/transfer/DERIVATION.txt",
   "Classes" -> {1, 3, 6, 10, 11, 13, 17}, "Components" -> {"XX", "NN"},
   "Scope" -> "Separate endpoint expansion, coupling renormalization and collinear subtraction reproduce regular, D0, D1 and delta coefficients and XX=NN at symbolic kinematics and scales.",
   "SharedInputs" -> "Dimensional Born terms, amplitude algebra, reduced scalar integrals, master values and conventions.",
   "CrossedComparison" -> "Assembly consistency for 56 component slots; direct/crossed Born and reduced-real inputs already agree. These are not 56 independent crossing derivations.",
   "PhysicsControls" -> "Four class-1 reconstructions omit dimensional Born terms or the fragmentation epsilon factor, separately in XX and NN; each changes the finite result.",
   "ComparatorControls" -> "Polynomial perturbations test the comparison routine only."|>,

 "LeptonScaleConvolutions" -> <|
   "Script" -> "Checks/check_lepton_scales.wls",
   "Channels" -> {"UU QQ", "UU QG", "UU GQ", "LL QQ", "LL QG", "LL GQ"},
   "Routes" -> {"FeynCalc", "FORM", "Tracer"},
   "Scope" -> "Independent PDF, fragmentation and photon-in-lepton residues, compared with saved poles and finite scale-log derivatives.",
   "AuxiliaryDataset" -> "Coefficients/LeptonScaleResidues.wl",
   "Conventions" -> "docs/LEPTON-SCALES.txt"|>,

 "AversaEndpointIdentities" -> <|
   "Script" -> "Checks/AversaEndpoints.wls", "Derivation" -> "Checks/AVERSA-ENDPOINTS.txt",
   "Scope" -> "q g -> q, UU: Born and D0, D1, delta coefficients including finite PDF/FF scheme conversion. Generic kinematics, color, flavor and separate scales; no generic regular comparison."|>,

 "SelectedUnresolvedLimits" -> <|
   "Script" -> "Checks/UnresolvedLimits.wls", "Dimension" -> 4,
   "Scope" -> "qq' -> qq'g: soft-gluon and polarized-incoming-quark collinear limits, UU/LL and transfer XX/NN; gg -> ggg: sampled identical-gluon exchange and weight 1/2.",
   "Arithmetic" -> "Exact rational functions for limits; three exchange probes specified in the script."|>,

 "QGInterferences" -> <|
   "Script" -> "Checks/QGExchange.wls",
   "Scope" -> "qg -> qgg, 136 pairs per UU/LL; 12 exact zeros and 124 expressions with nonzero witnesses. Exchange tested at three exact-rational points.",
   "Dimension" -> 4,
   "ExchangePoints" -> {
     <|"s" -> 17, "t" -> -7, "u" -> -6, "A" -> -2, "B" -> -5, "C" -> 3, "Nc" -> 3, "gs" -> 1|>,
     <|"s" -> 23, "t" -> -8, "u" -> -9, "A" -> -4, "B" -> -6, "C" -> 4, "Nc" -> 5, "gs" -> 1|>,
     <|"s" -> 31, "t" -> -12, "u" -> -11, "A" -> -5, "B" -> -9, "C" -> 6, "Nc" -> 7, "gs" -> 1|>},
   "ExchangeMap" -> "A -> -(s+t)-A, B -> -(s+u)-B, C -> -t-u-C"|>
|>
