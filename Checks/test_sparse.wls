$HistoryLength = 0;
Get[FileNameJoin[{DirectoryName[$InputFileName], "..", "FeynFacet", "Preprocessing.wl"}]];
passed = 0;
check[label_, condition_] := If[TrueQ[condition], passed++; Print["PASS ", label], Print["FAIL ", label]; Exit[1]];
geometryCalls = 0;
geometry[expr_] := (geometryCalls++; expr /. 1/(fA fB) -> (1/fA + 1/fB)/c);
convert = CreatePartialFractionConverter[{fA, fB}, hat, geometry];
r = convert[c1/(fA fB) + c2 hat/(fA fB)];
check["one geometry map for two hat powers", geometryCalls === 1 && r["CacheHits"] === 1];
check["partial fractions reconstruct exactly", Together[(Total[r["Terms"]] - (c1+c2 hat)/(fA fB)) /. fB -> c-fA] === 0];
r2 = convert[D/(fA fB)];
check["cache reused between spin components", geometryCalls === 1 && r2["CacheHits"] === 1];
check["trace D stays in scalar coefficient", Together[Total[r2["Terms"]] /. {fA -> 2, fB -> 3, c -> 5}] === D/6];
check["zero yields no terms", convert[0]["Terms"] === {}];
check["coefficient cancellation occurs first", convert[(1/(s-t)-(s+t)/(s^2-t^2))/(fA fB)]["Terms"] === {}];
check["functional dependence rejected", FailureQ[convert[Sin[fA]]]];
check["Failure never enters grouping", FailureQ[convert[Failure["bad", <||>]]]];
bad = CreatePartialFractionConverter[{fA, fB}, hat, Function[z, Failure["bad", <||>]]];
check["nested geometry failure exits converter", FailureQ[bad[1/fA]]];
unitCalls = 0;
unitRows[unit_] := (unitCalls++; {<|"Integral" -> k[-Exponent[unit,fA]], "HatPower" -> Exponent[unit,hat],
 "Coefficient" -> 1|>});
reconstruct[term_, rows_] := Together[Total[(#["Coefficient"] fA^(-#["Integral"][[1]]) hat^#["HatPower"]) & /@ rows]-term] === 0;
rowConvert = CreateIntegralRowConverter[{fA,hat}, unitRows, reconstruct];
rows = rowConvert[{(D+d)/fA, c1 hat/fA^2}];
check["all scaled rows reconstruct", ListQ[rows["Rows"]] && Length[rows["Rows"]] === 2];
rows = rowConvert[{c2/fA}];
check["family geometry reused across components", unitCalls === 2 && rows["CacheHits"] === 1];
check["fractional monomials rejected", FailureQ[rowConvert[{Sqrt[fA]}]]];
check["bad row reconstruction rejected", FailureQ[CreateIntegralRowConverter[{fA}, unitRows, Function[{a,b},False]][{1/fA}]]];
check["zero row list stays empty", rowConvert[{}]["Rows"] === {}];
Print[passed," sparse helper tests passed."];
Exit[0];
